{
  "startup": {
    "type": "table.simple",
    "options": {
      "showSerial": true,
      "showSearch": true,
      "showOptions": false
    },
    "classToApply": "",
    "appendPosition": "replace"
  },
  "search": {
    "captureQuery": [
      {
        "sourcePath": {
          "fileName": "root"
        },
        "func": "isKey",
        "arguments": {
          "key": "Enter"
        }
      },
      {
        "sourcePath": {
          "fileName": "previous"
        },
        "func": "readValue"
      }
    ]
  },
  "clearBody": {
    "findLiveBody": [
      {
        "sourcePath": {
          "fileName": "root"
        },
        "func": "closest",
        "arguments": {
          "selector": ".v52-root"
        }
      },
      {
        "sourcePath": {
          "fileName": "previous"
        },
        "func": "querySelector",
        "arguments": {
          "selector": "#dom-render-container tbody"
        }
      }
    ]
  },
  "showBody": {
    "findLiveBody": [
      {
        "sourcePath": {
          "fileName": "root"
        },
        "func": "closest",
        "arguments": {
          "selector": ".v52-root"
        }
      },
      {
        "sourcePath": {
          "fileName": "previous"
        },
        "func": "querySelector",
        "arguments": {
          "selector": "#dom-render-container tbody"
        }
      }
    ]
  }
}
